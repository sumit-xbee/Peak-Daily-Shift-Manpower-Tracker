# Copy to .env.local for local work, and set the same names in Vercel (Project Settings > Environment Variables).
# NEVER commit real values. This repo is public until you make it private.

# Supabase: Project Settings > API
SUPABASE_URL=https://<your-project-ref>.supabase.co
# The SECRET key (sb_secret_...) or legacy service_role key. Server-only. Never expose it in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Gmail sender (Google Workspace). Use an APP PASSWORD (16 characters), not the account password.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Random strings, at least 32 characters each. Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
CRON_SECRET=

# Public URL of the deployed app, no trailing slash. Used inside email links.
APP_BASE_URL=http://localhost:3000
